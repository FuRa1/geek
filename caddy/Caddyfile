# ---------------------------------------------------------------------------
# /opt/home-infra/caddy/Caddyfile
#
# One public hostname, three kinds of route:
#
#   /outpost.goauthentik.io/*  → authentik   (MUST stay unauthenticated)
#   /guacamole/*               → guacamole   (gated by forward_auth)
#   everything else            → authentik   (login UI, admin, API)
#
# Why authentik owns "/" and the apps get sub-paths: authentik cannot be
# hosted under a sub-path, and a dynip hostname gives you exactly one name,
# so per-app sub-domains would each need their own certificate and DNS entry.
# Guacamole is the one app that survives this happily — its image already
# serves at /guacamole (WEBAPP_CONTEXT), so no prefix rewriting is involved.
#
# Reload after editing, without dropping connections:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# ---------------------------------------------------------------------------

{
	email {$CADDY_EMAIL}
	# Uncomment while testing to avoid burning Let's Encrypt rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$CADDY_DOMAIN} {
	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# --- authentik outpost endpoints ---------------------------------------
	# The /auth/ check below calls back into these. Gating them would create
	# an infinite redirect loop, so they are matched first and pass through.
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik-server:9000
	}

	# --- Guacamole, behind authentik ---------------------------------------
	# forward_auth asks authentik about every request before proxying. On a
	# non-2xx answer Caddy returns authentik's response verbatim, which is the
	# 302 into the login flow — that is what actually enforces auth. Routing
	# /auth/* to authentik, on its own, would protect nothing.
	handle /guacamole/* {
		forward_auth authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy

			# Identity of the signed-in user, handed to the upstream. Caddy
			# only copies these from authentik's reply, so a client cannot
			# forge them.
			copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid X-authentik-jwt X-authentik-meta-jwks X-authentik-meta-outpost X-authentik-meta-provider X-authentik-meta-app X-authentik-meta-version
		}

		# Guacamole's tunnel is a WebSocket; reverse_proxy upgrades it
		# automatically, but the read timeout has to outlive an idle desktop.
		reverse_proxy guacamole:8080 {
			transport http {
				read_timeout 12h
				write_timeout 12h
			}
		}
	}

	# --- Open WebUI, behind authentik ----------------------------------------
	# WEBUI_URL is configured with this same /ai/ prefix; do not strip it.
	handle /ai/* {
		forward_auth authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid X-authentik-jwt X-authentik-meta-jwks X-authentik-meta-outpost X-authentik-meta-provider X-authentik-meta-app X-authentik-meta-version
		}

		reverse_proxy open-webui:8080 {
			transport http {
				read_timeout 12h
				write_timeout 12h
			}
			flush_interval -1
		}
	}

	# --- authentik itself ---------------------------------------------------
	handle {
		reverse_proxy authentik-server:9000
	}
}

# ---------------------------------------------------------------------------
# Uptime Kuma
#
# Kuma has no sub-path support: served under /kuma/ its asset and socket.io
# URLs resolve against "/" and the dashboard breaks. Two working options:
#
#   1. Keep it Tailscale-only (current setup, nothing to do here).
#   2. Give it its own hostname and uncomment the block below. On a sapo
#      dynip name you only get one hostname, so this needs a real domain
#      (or DuckDNS) pointed at the same public IP.
#
# kuma.example.com {
# 	encode zstd gzip
# 	handle /outpost.goauthentik.io/* {
# 		reverse_proxy authentik-server:9000
# 	}
# 	handle {
# 		forward_auth authentik-server:9000 {
# 			uri /outpost.goauthentik.io/auth/caddy
# 			copy_headers X-authentik-username X-authentik-groups X-authentik-email
# 		}
# 		# Kuma runs outside this stack, on the host:
# 		reverse_proxy host.docker.internal:3001
# 	}
# }
#
# Note that gating Kuma this way also gates its public /status/ pages.
# ---------------------------------------------------------------------------
