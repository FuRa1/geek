# ---------------------------------------------------------------------------
# /opt/home-infra/.env.example  —  TEMPLATE ONLY. Never put real values here.
#
#   cp .env.example .env      (or: ./scripts/init-secrets.sh)
#   .env is git-ignored and must never be committed.
#
# Generate every CHANGE_ME below with:  openssl rand -base64 36 | tr -d '\n'
# ---------------------------------------------------------------------------

# --- Image tags (pin these; bump deliberately) -----------------------------
CADDY_TAG=2.8-alpine
POSTGRES_TAG=16-alpine
REDIS_TAG=7-alpine
AUTHENTIK_TAG=2024.12.3
GUACD_TAG=1.5.5
GUACAMOLE_TAG=1.5.5
OPEN_WEBUI_TAG=v0.11.3

# --- Public entrypoint ------------------------------------------------------
# The single hostname Caddy answers on. Everything is served under it.
CADDY_DOMAIN=control.moralmachine.dynip.sapo.pt
# Let's Encrypt registration address (expiry notices go here).
CADDY_EMAIL=you@example.com

# --- PostgreSQL (shared instance, one database per app) ---------------------
POSTGRES_USER=authentik
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=authentik

# Guacamole gets its own role + database inside the same instance,
# created by postgres/initdb/01-guacamole-db.sh on first boot.
GUACAMOLE_DB_NAME=guacamole
GUACAMOLE_DB_USER=guacamole
GUACAMOLE_DB_PASSWORD=CHANGE_ME

# --- Authentik --------------------------------------------------------------
# Signing key for sessions/tokens. Rotating it logs everyone out.
AUTHENTIK_SECRET_KEY=CHANGE_ME
# Bootstrap credentials for the initial akadmin user. Used only on first boot;
# change the password in the UI afterwards, then blank these out.
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME
AUTHENTIK_BOOTSTRAP_EMAIL=you@example.com

# Optional outbound mail for password resets / notifications.
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=authentik@example.com

# --- Host paths -------------------------------------------------------------
# Where bind-mounted runtime data lives. Keep it inside the stack directory so
# backup.sh and migrate-to-t640.sh can move everything as one unit.
DATA_ROOT=./data

# --- Timezone ---------------------------------------------------------------
TZ=Europe/Lisbon

# --- Open WebUI / Ollama ----------------------------------------------------
# Open WebUI is published at https://${CADDY_DOMAIN}/ai/ behind Authentik.
# Ollama remains private on the MoralMachine Tailscale address.
OPEN_WEBUI_URL=https://moralmachine.dynip.sapo.pt/ai
OLLAMA_BASE_URL=http://100.84.255.108:11434
